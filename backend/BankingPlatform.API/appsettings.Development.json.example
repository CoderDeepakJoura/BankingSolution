{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JwtSettings": {
    "SecretKey": "<base64-encoded-key-at-least-32-bytes>",
    "Issuer": "BankingAPI",
    "Audience": "BankingClients",
    "ExpiryDays": 1,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "BankingDatabase": "Host=localhost;Database=SecureBankDB;Username=<user>;Password=<password>"
  },
  "DocPaths": {
    "MemberImagesDrive": "D:",
    "AccountImagesDrive": "D:"
  },
  "ScriptPath": {
    "LoanAdvancement": "E:\\Selenium"
  },
  "AllowedHosts": "localhost"
}
